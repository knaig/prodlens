# OpenAI-compatible LLM endpoint used by ALL LLM features: journey synthesis
# ('prioritize'), the agent fallback ('run'), GEPA reflection ('gepa'), the
# visual QA pass ('visual'), and demo auto-narration / guided mode. Any
# OpenAI-compatible API works - DeepSeek, Qwen/DashScope, Kimi/Moonshot,
# OpenRouter, or a local server (Ollama/LM Studio). Examples:
#   LLM_BASE_URL=https://openrouter.ai/api          # one key for deepseek/qwen/kimi
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_BASE_URL=https://api.moonshot.cn/v1
#   LLM_BASE_URL=http://localhost:1234              # local server, no key needed
LLM_BASE_URL=

# API key for the endpoint above. Omit for local servers that need no auth.
# With OpenRouter, one key covers all the cheap models (deepseek/qwen/kimi).
LLM_API_KEY=

# Text model for the non-vision LLM paths (synthesis, GEPA, agent fallback).
# DeepSeek: deepseek/deepseek-v4-flash | Qwen: qwen/qwen3-32b | Kimi: moonshotai/kimi-k2
LLM_MODEL=deepseek/deepseek-v4-flash

# Vision-capable model for screenshot-reading paths (visual QA, demo auto-
# narrate + guided mode). DeepSeek has no vision API - use Qwen/Kimi.
LLM_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct

# TTS backend for narrated videos (explain/demo): kokoro (local, free),
# gemini (needs GEMINI_API_KEY), or say (macOS). Auto-picks in that order.
TTS_BACKEND=kokoro

# Target app
UX_FLOW_BASE_URL=http://localhost:3100

# Clerk test credentials, if the target app uses Clerk auth (see @clerk/testing)
# https://clerk.com/docs/testing/playwright/overview
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
UX_FLOW_TEST_EMAIL=
UX_FLOW_TEST_PASSWORD=

# One-line description of the app, used in the prioritization prompt
UX_FLOW_APP_DESCRIPTION=
